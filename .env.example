# Copy to .env.local and fill in from your Supabase project (Project Settings > API).
# Fake values below.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable key is meant to be public; row-level security protects the data.
# NEVER put the secret key in a VITE_ variable: Vite ships those to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
